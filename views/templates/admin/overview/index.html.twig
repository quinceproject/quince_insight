{#
  Overview — 1:1 z prototypu `pg==='overview'` (`js/overview.js`): "Needs attention",
  karta na usluge, Connection. Dane z OverviewController (stan biezacy, bez okresow).
#}
{% extends '@Modules/quince_insight/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_insight/views/templates/admin/_macros/icons.html.twig' as icons %}

{% trans_default_domain 'Modules.Quinceinsight.Admin' %}

{% set dots = {ok: 'var(--success)', warn: 'var(--warning)', error: 'var(--danger)', off: 'var(--fg-3)', idle: 'var(--fg-3)'} %}

{% block quince_body %}
<div class="qc-screen">
    {% include '@Modules/quince_insight/views/templates/admin/_partials/head.html.twig' with {
        title: 'Overview', description: 'Is everything connected and sending, and what needs your attention.', margin: 24
    } only %}

    {% include '@Modules/quince_insight/views/templates/admin/overview/_notices.html.twig' with {notices: notices} only %}

    <div class="qc-grid" style="margin-bottom:20px">
        <div style="padding:14px 18px;border-bottom:1px solid var(--border);font-size:var(--text-sm);font-weight:var(--weight-bold)">{{ 'Needs attention'|trans }}</div>
        <div style="display:flex;flex-direction:column;gap:1px">
            {% for a in attention %}
                {% set danger = a.level == 'error' %}
                <div style="padding:12px 18px;display:flex;justify-content:space-between;align-items:center;gap:16px;background:{{ danger ? 'var(--danger-soft)' : 'var(--warning-soft)' }}">
                    <div style="font-size:var(--text-sm);display:flex;gap:8px;align-items:flex-start">
                        <span style="flex:none;margin-top:2px;color:{{ danger ? 'var(--danger)' : 'var(--warning)' }}">{{ icons.icon(danger ? 'alertCircle' : 'alertTriangle', 14) }}</span>
                        <span>{{ a.message|trans(a.params) }}</span>
                    </div>
                    <a href="{{ a.url }}" style="font-size:var(--text-xs);font-weight:var(--weight-bold);white-space:nowrap;color:{{ danger ? 'var(--danger)' : 'var(--warning)' }}">{{ a.action|trans }}</a>
                </div>
            {% else %}
                <div class="qc-empty" style="padding:24px 20px">
                    {{ icons.icon('checkCircle', 28, 'qc-empty-icon') }}
                    <div class="qc-empty-text">{{ 'Nothing to fix right now.'|trans }}</div>
                </div>
            {% endfor %}
        </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(320px,100%),1fr));gap:16px;margin-bottom:20px">
        {% for c in cards %}
            <div class="qc-grid{{ c.state == 'off' ? ' qc-disabled-area' : '' }}"{% if c.state == 'off' %} style="opacity:.7"{% endif %}>
                <div class="qi-head qc-set-row" style="align-items:center">
                    <div class="qc-hstack" style="gap:8px;flex-wrap:nowrap">
                        <span class="qc-dot" style="background:{{ dots[c.state]|default('var(--fg-3)') }}"></span>
                        <span class="qc-set-title">{{ c.title|trans }}</span>
                    </div>
                    <a class="qc-linkbtn" href="{{ c.url }}">{{ (c.connect ? 'Connect' : 'Open')|trans }}</a>
                </div>
                <div class="qc-grid-row qi-row" style="grid-template-columns:1fr">
                    <div>
                        <div style="font-size:var(--text-sm);font-weight:var(--weight-semibold)">
                            {%- for l in c.lines %}{{ loop.first ? '' : ' · ' }}{{ l.text|trans(l.params) }}{% endfor -%}
                        </div>
                        {% if c.facts %}
                            <div class="qc-line" style="margin-top:4px">
                                {%- for f in c.facts %}{{ loop.first ? '' : ' · ' }}{{ f.text|trans(f.params) }}{% endfor -%}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="qc-grid">
        <div class="qi-head qc-set-row" style="align-items:center">
            <div class="qc-set-title">{{ 'Connection'|trans }}</div>
            <a class="qc-linkbtn" href="{{ path('quince_insight_settings') }}">{{ 'Settings'|trans }}</a>
        </div>
        <div class="qc-grid-row qi-row" style="grid-template-columns:repeat(4,1fr)">
            <div>
                <span class="qc-caption">{{ 'Google account'|trans }}</span>
                <div class="qc-hstack" style="gap:6px;flex-wrap:nowrap">
                    <span class="qc-dot{{ connection.state == 'ok' ? ' is-on' : '' }}"{% if connection.state == 'error' %} style="background:var(--danger)"{% endif %}></span>
                    {% if connection.email %}
                        <span class="qc-mono">{{ connection.email }}</span>
                    {% else %}
                        <span style="font-size:var(--text-sm)">{{ 'Not connected'|trans }}</span>
                    {% endif %}
                </div>
            </div>
            <div>
                <span class="qc-caption">{{ 'Access'|trans }}</span>
                <div style="font-size:var(--text-sm)">{{ '%granted% of %needed% permissions · refreshed automatically'|trans({'%granted%': connection.granted, '%needed%': connection.needed}) }}</div>
            </div>
            <div>
                <span class="qc-caption">{{ 'Scheduled tasks'|trans }}</span>
                <div style="font-size:var(--text-sm)">
                    {%- if connection.lastRun -%}
                        {{ '%count% crons · last run %date%'|trans({'%count%': connection.crons, '%date%': connection.lastRun}) }}
                    {%- else -%}
                        {{ '%count% crons · not run yet'|trans({'%count%': connection.crons}) }}
                    {%- endif -%}
                </div>
            </div>
            <div>
                <span class="qc-caption">{{ 'Module'|trans }}</span>
                <div style="font-size:var(--text-sm)">Quince Insight {{ version }}</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
