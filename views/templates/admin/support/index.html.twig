{#
  Support. Na gorze wsparcie projektu (ekran Support z Quince Engine w wariancie
  samodzielnego modulu: bez listy modulow, jeden przycisk do zgloszen tego modulu;
  style w `views/css/pages/support.css`, adresy w `Ui\SupportLinks`). Pod nim
  wizytowka z prototypu `pg==='support'` i (paczka A, wzor Quince CMP)
  "System information" do zgloszenia bledu (bez sekretow, ladowane na zadanie) i changelog.
#}
{% extends '@Modules/quince_insight/views/templates/admin/layout.html.twig' %}
{% import '@Modules/quince_insight/views/templates/admin/_macros/icons.html.twig' as icons %}

{% trans_default_domain 'Modules.Quinceinsight.Admin' %}

{% block quince_styles %}
    <link rel="stylesheet" href="{{ asset(qiAssets ~ 'css/pages/support.css') ~ qcVer }}">
{% endblock %}

{% block quince_body %}
<div class="qc-screen qc-settings">
    <div class="qc-support">

        <section class="qc-support-kofi">
            <span class="qc-support-heart">{{ icons.icon('heart', 32) }}</span>
            <div>
                <h2>{{ 'Support Quince'|trans }}</h2>
                <p>{{ 'Quince modules are free. If they are useful to you, support their development on Ko-fi.'|trans }}</p>
            </div>
            <a class="qc-support-kofi-btn" href="{{ kofi }}" target="_blank" rel="noopener">
                {{ 'Support on Ko-fi'|trans }}
                {{ icons.icon('arrowRight', 16) }}
            </a>
        </section>

        <section class="qc-support-hero">
            <div class="qc-support-wash" aria-hidden="true"></div>
            <i class="qc-support-beam b1" aria-hidden="true"></i><i class="qc-support-beam b2" aria-hidden="true"></i><i class="qc-support-beam b3" aria-hidden="true"></i><i class="qc-support-beam b4" aria-hidden="true"></i>

            <div class="qc-support-mark">
                <img src="{{ asset('../modules/quince_insight/views/img/quince-q.png') }}" width="64" height="64" alt="">
                <p class="qc-support-word">Quince Project</p>
            </div>

            <p class="qc-support-sub">{{ 'You use %module% in your shop. Help us develop it.'|trans({'%module%': 'Insight'}) }}</p>
            <p class="qc-support-text">{{ 'Report a bug, describe what your shop is missing or share a remark on the module page on GitHub. %module% is part of Quince Project, a set of free modules for PrestaShop.'|trans({'%module%': 'Insight'}) }}</p>

            <div class="qc-support-ways">
                <div class="qc-support-way" style="--qs-way: var(--qs-amber)">
                    <b>{{ 'Report a bug'|trans }}</b>
                    <span>{{ 'Say what happened and how to repeat it. Give the versions of PrestaShop and the module.'|trans }}</span>
                </div>
                <div class="qc-support-way" style="--qs-way: var(--qs-lilac)">
                    <b>{{ 'Suggest a change'|trans }}</b>
                    <span>{{ 'Describe what you need and in what situation in your shop.'|trans }}</span>
                </div>
                <div class="qc-support-way" style="--qs-way: var(--qs-sky)">
                    <b>{{ 'Share a remark'|trans }}</b>
                    <span>{{ 'What is unclear in the panel or in the module description.'|trans }}</span>
                </div>
            </div>

            <div class="qc-support-actions">
                <a class="qc-support-btn" href="{{ issues }}" target="_blank" rel="noopener">
                    {{ 'Report on GitHub'|trans }}
                    {{ icons.icon('arrowRight', 16) }}
                </a>
                <a class="qc-support-btn qc-support-btn--line" href="{{ project }}" target="_blank" rel="noopener">{{ 'Project website'|trans }}</a>
            </div>
        </section>

    </div>

    <div class="qc-grid" style="margin-top:20px">
        <div class="qc-about">
            <div class="qc-about-mark">{{ icons.icon('layout', 28) }}</div>
            <div class="qc-about-name">Quince Insight</div>
            <div class="qc-about-tagline">{{ 'Google for PrestaShop, in one place'|trans }}</div>
            <div class="qc-about-claim">{{ 'Search Console, Analytics, Tag Manager and Merchant Center connected through one setup. Free and open source.'|trans }}</div>
            <div class="qc-line" style="margin-top:8px">{{ 'Version %version%'|trans({'%version%': version}) }}</div>
        </div>
    </div>

    <div class="qc-cols" style="margin-top:20px">
        <div class="qc-settings-list">
            <div class="qc-grid" style="padding:16px 18px" x-data="{
                    open: false, loaded: false, busy: false, text: '', errors: [],
                    url: {{ path('quince_insight_support_diagnostics')|json_encode }},
                    load() { this.busy = true; return QI.post(this.url, {}).then(r => { this.busy = false; if (r.ok) { this.text = r.text; this.errors = r.errors || []; this.loaded = true; } }); },
                    toggle() { this.open = !this.open; if (this.open && !this.loaded) { this.load(); } }
                }">
                <div class="qc-hstack" style="justify-content:space-between">
                    <div>
                        <div class="qc-set-title">{{ 'System information'|trans }}</div>
                        <div class="qc-line" style="margin:2px 0 0">{{ 'Paste this into a bug report. Secrets and tokens are never included.'|trans }}</div>
                    </div>
                    <div class="qc-hstack" style="gap:8px;flex-wrap:nowrap">
                        <button type="button" class="qc-btn qc-btn-sm qc-btn-outline" x-show="loaded" x-cloak @click="QI.copy(text)">{{ 'Copy'|trans }}</button>
                        <button type="button" class="qc-btn qc-btn-sm qc-btn-outline" @click="toggle()">
                            {{ icons.icon('chevronDown', 13) }}
                            <span x-text="open ? {{ 'Hide'|trans|json_encode }} : {{ 'Show'|trans|json_encode }}">{{ 'Show'|trans }}</span>
                        </button>
                    </div>
                </div>
                <div x-show="open" x-cloak style="margin-top:14px">
                    <span class="qc-spinner" x-show="busy"></span>
                    <div class="qc-mono qc-pre" x-show="loaded" x-text="text"></div>
                </div>
            </div>
        </div>

        <div class="qc-settings-list">
            <div class="qc-grid" style="padding:16px 18px">
                <div class="qc-set-title" style="margin-bottom:8px">{{ 'Changelog'|trans }}</div>
                {% if changelog %}
                    <div class="qc-mono qc-pre" style="max-height:420px;overflow:auto;white-space:pre-wrap">{{ changelog }}</div>
                {% else %}
                    <div class="qc-line" style="margin:0">{{ 'This package has no changelog file.'|trans }}</div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
