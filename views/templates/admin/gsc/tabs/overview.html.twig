{# Search Console → Overview — 1:1 z prototypu (`sc.tab==='overview'`). #}
{% trans_default_domain 'Modules.Quinceinsight.Admin' %}
<div class="qc-settings-list">
    <div class="qc-grid" x-data="qiGscOverview({{ {summaries: gsc.summaries}|json_encode }})">
        <div class="qi-head qc-set-row" style="align-items:center">
            <div class="qc-set-title">{{ 'Search results'|trans }}</div>
            <div class="qc-seg">
                {% for p in ['7', '28', '90'] %}
                    <button type="button" class="qc-seg-btn" :class="{'is-active': period === '{{ p }}'}" @click="period = '{{ p }}'">{{ '%days% days'|trans({'%days%': p}) }}</button>
                {% endfor %}
            </div>
        </div>
        {% if gsc.hasData %}
            <div class="qc-grid-row qi-row" style="grid-template-columns:repeat(4,1fr)">
                <template x-for="m in tiles()" :key="m.label">
                    <div>
                        <span class="qc-caption" x-text="{{ {'Clicks': 'Clicks'|trans, 'Impressions': 'Impressions'|trans, 'CTR': 'CTR'|trans, 'Average position': 'Average position'|trans}|json_encode }}[m.label] || m.label"></span>
                        <div style="font-size:var(--text-base);font-weight:var(--weight-bold)" x-text="m.value"></div>
                        <span class="qc-badge" :class="m.up ? 'qc-badge-success' : 'qc-badge-danger'" x-text="m.delta"></span>
                    </div>
                </template>
            </div>
            <div class="qc-grid-row qi-row" style="grid-template-columns:1fr">
                <div style="display:flex;align-items:flex-end;gap:3px;height:100px">
                    <template x-for="(v, i) in trend()" :key="i">
                        <div style="flex:1;border-radius:3px 3px 0 0;background:var(--accent)" :style="{height: v.height + '%'}" :title="v.day + ' · ' + v.clicks"></div>
                    </template>
                </div>
            </div>
        {% else %}
            {% include '@Modules/quince_insight/views/templates/admin/_partials/empty.html.twig' with {
                icon: 'search', title: 'No data yet',
                text: 'Search results appear in Search Console 2–3 days after Google starts showing the shop. The module imports them every night.'
            } only %}
        {% endif %}
    </div>

    <div class="qc-cols">
        <div class="qc-grid">
            <div class="qi-head"><div class="qc-set-title">{{ 'Property'|trans }}</div></div>
            <div class="qc-grid-row qi-row" style="grid-template-columns:140px 1fr"><span class="qc-caption" style="margin:0">{{ 'Property'|trans }}</span><span class="qc-mono">{{ gsc.site }}</span></div>
            <div class="qc-grid-row qi-row" style="grid-template-columns:140px 1fr auto">
                <span class="qc-caption" style="margin:0">{{ 'Verification'|trans }}</span>
                {% if gsc.verify == 'verified' %}
                    <span style="font-size:var(--text-sm)">{{ 'Meta tag added by the module'|trans }}</span>
                    <span class="qc-badge qc-badge-success">{{ 'Verified'|trans }}</span>
                {% elseif gsc.verify == 'manual' %}
                    <span style="font-size:var(--text-sm)">{{ 'Verified another way'|trans }}</span>
                    <span class="qc-badge qc-badge-success">{{ 'Verified'|trans }}</span>
                {% else %}
                    <span style="font-size:var(--text-sm)">{{ 'Not verified by the module'|trans }}</span>
                    <span class="qc-badge qc-badge-warning">{{ 'Not verified'|trans }}</span>
                {% endif %}
            </div>
            <div class="qc-grid-row qi-row" style="grid-template-columns:140px 1fr"><span class="qc-caption" style="margin:0">{{ 'Your access'|trans }}</span><span style="font-size:var(--text-sm)">{{ gsc.permission ? gsc.permission|trans : '—' }}</span></div>
            <div class="qc-grid-row qi-row" style="grid-template-columns:140px 1fr auto">
                <span class="qc-caption" style="margin:0">{{ 'Sitemap'|trans }}</span>
                <span style="font-size:var(--text-sm)">
                    {%- if gsc.mode == 'existing' -%}
                        {{ gsc.submittedAt ? 'Existing sitemap · submitted %date%'|trans({'%date%': gsc.submittedAt}) : 'Existing sitemap · not submitted yet'|trans }}
                    {%- else -%}
                        {{ gsc.submittedAt ? 'Generated by the module · submitted %date%'|trans({'%date%': gsc.submittedAt}) : 'Generated by the module · not submitted yet'|trans }}
                    {%- endif -%}
                </span>
                <a class="qc-linkbtn" href="{{ path('quince_insight_gsc', {'tab': 'sitemap'}) }}">{{ 'Manage'|trans }}</a>
            </div>
            <div class="qc-grid-row qi-row" style="grid-template-columns:1fr">
                <div><a class="qc-btn qc-btn-sm qc-btn-outline" href="{{ path('quince_insight_wizard', {'step': 'gsc'}) }}">{{ 'Change property'|trans }}</a></div>
            </div>
        </div>

        <div class="qc-grid">
            <div class="qi-head qc-set-row">
                <div>
                    <div class="qc-set-title">{{ 'Sitemap health'|trans }}</div>
                    <div class="qc-line" style="margin-top:4px">{{ 'Checked by the module at every rebuild — no Google quota used.'|trans }}</div>
                </div>
                <a class="qc-linkbtn" href="{{ path('quince_insight_gsc', {'tab': 'sitemap'}) }}">{{ 'Sitemap'|trans }}</a>
            </div>
            {% if gsc.mode == 'module' and gsc.hasIndex %}
                <div class="qc-grid-row qi-row" style="grid-template-columns:auto 1fr"><span class="qc-dot is-on"></span><span style="font-size:var(--text-sm)">{{ '%count% addresses in the sitemap, all reachable'|trans({'%count%': gsc.urlTotal|number_format(0, '.', ' ')}) }}</span></div>
                <div class="qc-grid-row qi-row" style="grid-template-columns:auto 1fr"><span class="qc-dot"></span><span style="font-size:var(--text-sm)">{{ '%count% addresses left out at the last rebuild'|trans({'%count%': gsc.skipped.total}) }}</span></div>
            {% elseif gsc.mode == 'module' %}
                <div class="qc-grid-row qi-row" style="grid-template-columns:auto 1fr"><span class="qc-dot"></span><span style="font-size:var(--text-sm)">{{ 'The sitemap has not been generated yet.'|trans }}</span></div>
            {% else %}
                <div class="qc-grid-row qi-row" style="grid-template-columns:auto 1fr"><span class="qc-dot"></span><span style="font-size:var(--text-sm)">{{ 'The shop uses an existing sitemap — the module does not check its addresses.'|trans }}</span></div>
            {% endif %}
            <div class="qc-grid-row qi-row" style="grid-template-columns:1fr auto">
                <div class="qc-line">{{ 'Which pages Google indexes and why others are left out is in the Page indexing report.'|trans }}</div>
                <a class="qc-linkbtn" href="https://search.google.com/search-console/index?resource_id={{ gsc.site|url_encode }}" target="_blank" rel="noopener">{{ 'Open report'|trans }}</a>
            </div>
        </div>
    </div>
</div>
