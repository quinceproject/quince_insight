{# Search Console → Sitemap — 1:1 z prototypu (`sc.tab==='sitemap'`). #}
{% trans_default_domain 'Modules.Quinceinsight.Admin' %}
{% set g = gsc.google %}
<div class="qc-cols" x-data="qiGscSitemap({{ {
        include: gsc.include,
        robotsLine: gsc.robotsLine,
        job: gsc.job,
        googleStale: gsc.googleStale,
        reloadOnRefresh: true,
        rebuildUrl: path('quince_insight_sitemap_rebuild'),
        submitUrl: path('quince_insight_sitemap_submit'),
        removeUrl: path('quince_insight_sitemap_remove'),
        saveUrl: path('quince_insight_sitemap_save'),
        refreshUrl: path('quince_insight_gsc_refresh'),
        tickUrl: path('quince_insight_job_tick'),
        t: {
            rebuilt: 'Sitemap rebuilt — %count% addresses'|trans,
            submitted: 'Sitemap submitted to Search Console'|trans,
            removed: 'Removed from Search Console'|trans,
            failed: 'Something went wrong. Details are in the module log.'|trans
        }
    }|json_encode }})">
    <div class="qc-settings-list">
        <div class="qc-grid">
            <div class="qi-head qc-set-row" style="align-items:center">
                <div>
                    <div class="qc-set-title">{{ gsc.mode == 'existing' ? 'Existing sitemap'|trans : 'Sitemap generated by Quince Insight'|trans }}</div>
                    <div class="qc-mono" style="margin-top:4px;color:var(--fg-2)">{{ gsc.mode == 'existing' ? gsc.existingUrl : gsc.indexUrl }}</div>
                </div>
                {% if g is null %}
                    <span class="qc-badge">{{ gsc.submittedAt ? 'Waiting for Google'|trans : 'Not submitted'|trans }}</span>
                {% elseif g.state == 'error' %}
                    <span class="qc-badge qc-badge-danger">{{ '%count% errors in Google'|trans({'%count%': g.errors}) }}</span>
                {% elseif g.state == 'warning' %}
                    <span class="qc-badge qc-badge-warning">{{ '%count% warnings in Google'|trans({'%count%': g.warnings}) }}</span>
                {% elseif g.state == 'pending' %}
                    <span class="qc-badge">{{ 'Waiting for Google'|trans }}</span>
                {% else %}
                    <span class="qc-badge qc-badge-success">{{ 'Success in Google'|trans }}</span>
                {% endif %}
            </div>
            {% if gsc.mode == 'module' %}
                {% if gsc.files is not empty %}
                    <div class="qc-grid-head" style="grid-template-columns:1fr 70px 90px;padding:10px 18px"><div>{{ 'File'|trans }}</div><div>{{ 'Language'|trans }}</div><div>{{ 'Addresses'|trans }}</div></div>
                    {% for f in gsc.files %}
                        <div class="qc-grid-row qi-row" style="grid-template-columns:1fr 70px 90px">
                            <span class="qc-mono">{{ f.file }}</span>
                            <span class="qc-line">{{ f.lang }}</span>
                            <span class="qc-line">{{ f.urls|number_format(0, '.', ' ') }}</span>
                        </div>
                    {% endfor %}
                {% endif %}
                <div class="qc-grid-row qi-row" style="grid-template-columns:1fr auto">
                    <div>
                        <div style="font-size:var(--text-sm);font-weight:var(--weight-semibold)">{{ '%count% addresses'|trans({'%count%': gsc.urlTotal|number_format(0, '.', ' ')}) }}</div>
                        <div class="qc-line" style="margin-top:4px">
                            {{- gsc.lastBuild ? 'Rebuilt %date%'|trans({'%date%': gsc.lastBuild}) : 'Not built yet'|trans -}}
                            {{- ' · ' -}}
                            {{- gsc.submittedAt ? 'submitted %date%'|trans({'%date%': gsc.submittedAt}) : 'not submitted yet'|trans -}}
                            {{- ' · ' ~ 'rebuilt nightly by cron'|trans -}}
                        </div>
                    </div>
                    <div class="qc-hstack" style="gap:8px;flex-wrap:nowrap">
                        <button type="button" class="qc-btn qc-btn-sm qc-btn-outline" @click="rebuild()" :disabled="rebuilding"><span class="qc-spinner" x-show="rebuilding" x-cloak></span> {{ 'Rebuild'|trans }}</button>
                        <button type="button" class="qc-btn qc-btn-sm qc-btn-primary" @click="submit()" :disabled="submitting || rebuilding || {{ gsc.hasIndex ? 'false' : 'true' }}"><span class="qc-spinner" x-show="submitting" x-cloak></span> {{ 'Submit'|trans }}</button>
                    </div>
                </div>
                {# decyzja #19: zgoda na linie `Sitemap:` w robots.txt, domyslnie wylaczona; modul nie pisze pliku sam #}
                <label class="qc-grid-row qi-row" style="grid-template-columns:1fr auto;cursor:pointer">
                    <div>
                        <div class="qc-set-title">{{ 'Add the sitemap to robots.txt'|trans }}</div>
                        <div class="qc-line" style="margin-top:4px">{{ 'The line “Sitemap: %url%” appears in robots.txt the next time PrestaShop writes the file — click Generate robots.txt file in Shop Parameters → Traffic & SEO.'|trans({'%url%': gsc.indexUrl}) }}</div>
                    </div>
                    <span class="qc-toggle"><input type="checkbox" x-model="robotsLine"><span class="qc-toggle-track"></span></span>
                </label>
            {% else %}
                <div class="qc-grid-row qi-row" style="grid-template-columns:1fr auto">
                    <div class="qc-line">{{ gsc.submittedAt ? 'Submitted %date%'|trans({'%date%': gsc.submittedAt}) : 'Not submitted yet'|trans }}</div>
                    <button type="button" class="qc-btn qc-btn-sm qc-btn-primary" @click="submit()" :disabled="submitting"><span class="qc-spinner" x-show="submitting" x-cloak></span> {{ 'Submit'|trans }}</button>
                </div>
            {% endif %}
        </div>

        {% if gsc.mode == 'module' %}
        <div class="qc-grid">
            <div class="qi-head">
                <div class="qc-set-title">{{ 'Left out at the last rebuild'|trans }}</div>
                <div class="qc-line" style="margin-top:4px">{{ 'The sitemap lists only addresses Google can index. The module checks every address itself before writing the file.'|trans }}</div>
            </div>
            {% for r in gsc.skipped.rows %}
                <div class="qc-grid-row qi-row" style="grid-template-columns:1fr auto">
                    <div>
                        <div style="font-size:var(--text-sm)">{{ r.label|trans }}</div>
                        <div class="qc-sub" style="margin-top:4px">{{ r.why|trans }}</div>
                    </div>
                    <span class="qc-badge">{{ r.n }}</span>
                </div>
            {% endfor %}
        </div>
        {% endif %}

        {% if gsc.others is not empty %}
        <div class="qc-grid">
            <div class="qi-head">
                <div class="qc-set-title">{{ 'Other sitemaps Google knows'|trans }}</div>
                <div class="qc-line" style="margin-top:4px">{{ 'Submitted earlier, outside this module. Two sitemaps listing the same addresses are harmless but confusing.'|trans }}</div>
            </div>
            {% for o in gsc.others %}
                <div class="qc-grid-row qi-row" style="grid-template-columns:1fr auto auto" x-show="!removed[{{ o.path|json_encode }}]">
                    <span class="qc-mono" style="overflow:hidden;text-overflow:ellipsis">{{ o.path }}</span>
                    {% if o.lastDownloaded %}
                        <span class="qc-badge qc-badge-warning">{{ 'Last read %date%'|trans({'%date%': o.lastDownloaded}) }}</span>
                    {% else %}
                        <span class="qc-badge qc-badge-warning">{{ 'Never read'|trans }}</span>
                    {% endif %}
                    <button type="button" class="qc-linkbtn" @click="remove({{ o.path|json_encode }})">{{ 'Remove from Google'|trans }}</button>
                </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>

    {% if gsc.mode == 'module' %}
    <div class="qc-grid">
        <div class="qi-head">
            <div class="qc-set-title">{{ 'What the sitemap includes'|trans }}</div>
            <div class="qc-line" style="margin-top:4px">{{ 'Every shop language with hreflang. Files split every 50 000 addresses.'|trans }}</div>
        </div>
        {# decyzja #22: strona glowna zawsze w mapie, bez przelacznika #}
        <div class="qc-grid-row qi-row" style="grid-template-columns:1fr auto">
            <div>
                <div class="qc-set-title">{{ 'Home page'|trans }}</div>
                <div class="qc-line" style="margin-top:4px">{{ 'Every shop language, with x-default pointing to the default language.'|trans }}</div>
            </div>
            <span class="qc-badge">{{ 'Always included'|trans }}</span>
        </div>
        {% for o in [['products', 'Products'], ['images', 'Product images'], ['categories', 'Categories'], ['cms', 'CMS pages'], ['brands', 'Brands'], ['suppliers', 'Suppliers']] %}
            <label class="qc-grid-row qi-row" style="grid-template-columns:1fr auto;cursor:pointer">
                <span class="qc-set-title">{{ o[1]|trans }}</span>
                <span class="qc-toggle"><input type="checkbox" x-model="include.{{ o[0] }}"{% if o[0] == 'images' %} :disabled="!include.products"{% endif %}><span class="qc-toggle-track"></span></span>
            </label>
        {% endfor %}
        {% if gsc.blog.detected %}
        <div>
            <div class="qi-head qc-set-row" style="border-top:1px solid var(--border)">
                <div>
                    <div class="qc-set-title">{{ 'Quince Blog'|trans }}</div>
                    <div class="qc-mono" style="margin-top:4px;color:var(--fg-2)">{{ gsc.blog.url }}</div>
                </div>
                <span class="qc-badge qc-badge-success">{{ 'Detected'|trans }}</span>
            </div>
            {% for o in [['blog_list', 'Blog home page'], ['blog_posts', 'Posts'], ['blog_categories', 'Blog categories'], ['blog_tags', 'Tag pages']] %}
                <label class="qc-grid-row qi-row" style="grid-template-columns:1fr auto;cursor:pointer">
                    <div>
                        <div class="qc-set-title">{{ o[1]|trans }}</div>
                        {% if o[0] == 'blog_posts' %}<div class="qc-line" style="margin-top:4px">{{ 'Only published posts with a publish date up to today and without noindex. Last change date and cover image included.'|trans }}</div>{% endif %}
                        {% if o[0] == 'blog_categories' %}<div class="qc-line" style="margin-top:4px">{{ 'Only active categories.'|trans }}</div>{% endif %}
                        {% if o[0] == 'blog_tags' %}<div class="qc-line" style="margin-top:4px">{{ 'Off by default — tag pages usually repeat post lists and add little for search.'|trans }}</div>{% endif %}
                    </div>
                    <span class="qc-toggle"><input type="checkbox" x-model="include.{{ o[0] }}"><span class="qc-toggle-track"></span></span>
                </label>
            {% endfor %}
        </div>
        {% endif %}
        <div class="qc-grid-row qi-row" style="grid-template-columns:1fr">
            <div class="qc-line">{{ 'Products excluded in Merchant Center are still listed — the sitemap is for search, not Shopping. Inactive products and products with noindex are left out.'|trans }}</div>
        </div>
    </div>
    {% endif %}
</div>
