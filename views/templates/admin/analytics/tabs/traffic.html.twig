{# Zakladka Traffic — 1:1 z prototypu (`an.tab==='traffic'`). Dane: `report` z Reports::traffic(). #}
{% trans_default_domain 'Modules.Quinceinsight.Admin' %}
<div class="qc-settings-list">
    <div class="qc-grid">
        <div class="qi-head"><div class="qc-set-title">{{ 'Channels'|trans }}</div></div>
        <div class="qc-grid-head" style="grid-template-columns:1fr 180px 110px 110px 130px;padding:10px 18px"><div>{{ 'Channel'|trans }}</div><div>{{ 'Share of sessions'|trans }}</div><div>{{ 'Sessions'|trans }}</div><div>{{ 'Conversion'|trans }}</div><div>{{ 'Revenue'|trans }}</div></div>
        {% for c in report.channels %}
            <div class="qc-grid-row qi-row" style="grid-template-columns:1fr 180px 110px 110px 130px">
                <span class="qc-set-title">{{ c.name }}</span>
                <div class="qc-hstack" style="gap:8px;flex-wrap:nowrap">
                    <div style="flex:1;display:flex;height:8px;border-radius:99px;overflow:hidden;background:var(--surface-sunken)"><div style="width:{{ c.width }}%;background:var(--accent)"></div></div>
                    <span class="qc-line" style="width:34px;text-align:right">{{ c.share }}%</span>
                </div>
                <span class="qc-line">{{ c.sessions }}</span>
                <span class="qc-line">{{ c.conv }}</span>
                <span class="qc-line">{{ c.revenue }}</span>
            </div>
        {% endfor %}
    </div>
    <div class="qc-cols">
        {% for grp in [{t: 'Devices', rows: report.devices}, {t: 'Countries', rows: report.countries}] %}
        <div class="qc-grid">
            <div class="qi-head"><div class="qc-set-title">{{ grp.t|trans }}</div></div>
            {% for r in grp.rows %}
                <div class="qc-grid-row qi-row" style="grid-template-columns:120px 1fr 90px">
                    <span class="qc-set-title">{{ r.name == 'Other' ? 'Other'|trans : r.name }}</span>
                    <div style="display:flex;height:8px;border-radius:99px;overflow:hidden;background:var(--surface-sunken)"><div style="width:{{ r.share }}%;background:var(--accent)"></div></div>
                    <span class="qc-line" style="text-align:right">{{ r.share }}% · {{ r.sessions }}</span>
                </div>
            {% else %}
                <div class="qc-grid-row qi-row" style="grid-template-columns:1fr"><span class="qc-line">{{ 'No sessions in this period.'|trans }}</span></div>
            {% endfor %}
        </div>
        {% endfor %}
    </div>
</div>
